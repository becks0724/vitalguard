# === VitAlGuard / 조달청 제출 리포 — gitignore ===

# 의존성
node_modules/
.pnpm-store/

# 빌드 산출물
.next/
out/
dist/
build/
build_device/
.dart_tool/
*.tsbuildinfo

# 런타임·데이터 (생체·GPS·PII — 절대 커밋 금지)
.runtime/

# 환경변수·시크릿 (API 키 — 절대 커밋 금지)
.env
.env.*
!.env.example

# iOS / Flutter 사용자별 산출물
ios/Pods/
**/xcuserdata/
*.mode1v3
*.pbxuser

# OS / 에디터
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/

# 무거운 일회성 산출물
demo/
*.zip
*.mp4

# 감사 산출물 — 로컬 전용 (2026-07-27)
# 지적사항·취약점 위치가 그대로 적혀 있어 저장소에 두지 않는다.
# 파일은 디스크에 남고 추적만 하지 않는다. 과거 커밋에는 남아 있으므로,
# GitHub 에서까지 지우려면 히스토리 재작성 + GitHub Support purge 요청이 별도로 필요하다.
기존_조달청모듈/safetymonitor/docs/audit-*
audit/

# 모델 가중치 — 저장소에 넣지 않는다 (2026-09-21)
# 왜 여기(루트)인가 — 종전 보호는 cctv-ai/.gitignore 안에만 있어서 그 디렉터리 밖은 무방비였다.
# 실제로 워크트리 루트에 380MB 가 놓여 있었다(yolov8s-worldv2.pt 25.9MB + weights/clip 354MB).
# 폐기된 YOLO-World 경로의 잔해이고 ultralytics 가 자동으로 내려받은 것이다 — 규칙은 있었는데
# 구조가 안 막았다. `git add -A` 한 번이면 히스토리에 영구히 들어간다.
*.pt
*.engine
weights/
*.bak-*
# ultralytics 산출 디렉터리 — 가중치와 이미지가 한꺼번에 떨어지는 자리다.
#   project= 를 안 주면 cwd 기준 runs/detect/train 에 쏟고, 그 안에 val_batch*.jpg 와
#   weights/best.pt 가 같이 생긴다. best.pt 는 위 weights/ 로 이미 막히지만 jpg 는 안 막혔다.
runs/
#
# ⚠ 모델 확장자 중 **일부러 안 넣은 것** — 아래 둘은 앱에 실려 나가는 자산이라 추적해야 한다.
#   막으면 그 모델을 갱신할 때 조용히 빠진다. main 기준 실측(2026-09-21).
#     *.onnx      6개  Wear OS  ML 3종 모듈/ModelsWearOS/ · vitalguard_app/.../wear/assets/
#     *.mlmodel   9개  iOS·watchOS  ML 3종 모듈/Models/ · Watch/ML/ · VitalWatch/FallML/
#   ⚠ 세려면 `git -c core.quotepath=false ls-files` 로 센다 — 한글 경로가 섞여 있어
#     그냥 `ls-tree | grep '\.onnx$'` 는 따옴표 때문에 **0 이 나온다**(실제로 한 번 속았다).
#   ⚠ tmp-507e 같은 옛 가지에서 세면 onnx 0 개로 보인다(08-27 cfbd2ebd 로 들어왔고
#     그 가지는 08-12 에 갈라졌다). 판정은 main 에서 한다.
