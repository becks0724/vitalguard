<?xml version="1.0" encoding="utf-8"?>
<!-- 워치 단독 실측 프로브 — 권한은 Wear OS 6(API 36) 신·구 병기 (context-notes R-07) -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />

    <!-- 구권한: targetSdk 33~35 기기용. 36부터는 아래 health 권한이 대체한다 -->
    <!-- ⚠ maxSdkVersion 을 걸면 API 36+ 기기(이 워치는 **37**)에서 선언 자체가 사라지고,
         순정 SensorManager 의 TYPE_HEART_RATE 가 조용히 죽는다 — 08-25 실기에서 심박이
         값이 비어 있던 원인이 정확히 이것이다(dumpsys 에 BODY_SENSORS 항목 자체가 없었다).
         health 권한은 Health Services·삼성 SDK 용이고, **순정 센서는 여전히 BODY_SENSORS 를 본다.**
         둘 다 선언한다. -->
    <uses-permission android:name="android.permission.BODY_SENSORS" />
    <uses-permission android:name="android.permission.BODY_SENSORS_BACKGROUND" />
    <!-- 신권한: Wear OS 6(API 36)+ -->
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND" />
    <!-- 삼성 SDK 의 SpO₂·피부온 트래커가 요구하는 권한. **선언이 없으면 `pm grant` 가 조용히
         무시된다** — 08-25 실기에서 PERMISSION_ERROR 의 원인이 정확히 이것이었다.
         READ_HEART_RATE 만 선언돼 있어 그 하나만 부여됐다. -->
    <uses-permission android:name="android.permission.health.READ_OXYGEN_SATURATION" />
    <uses-permission android:name="android.permission.health.READ_SKIN_TEMPERATURE" />
    <!-- 활동 3종(걸음·층·칼로리) — Health Services PassiveMonitoring 이 요구한다.
         ⚠ 선언이 없으면 콜백이 **조용히 안 온다**(예외도 로그도 없다). 08-25 실기에서
         걸었는데 활동 로그 0건이었던 원인이 이것이다. READ_OXYGEN_SATURATION 때와 같은 함정. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_FLOORS_CLIMBED" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />

    <!-- 업로드(LTE 직결) — INTERNET 없이는 첫 POST 부터 SecurityException 이고, runCatching 이
         그것을 -1(네트워크 오류)로 삼켜 30초 재시도 무한루프가 된다(08-24 외부 리뷰가 잡음).
         ACCESS_NETWORK_STATE 는 실측 ⑧ 의 TRANSPORT_CELLULAR 바인딩에 필요하다 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

    <!-- GPS — 생체 + 위치 송출이 목표. 백그라운드 위치는 FGS location 타입으로 충족한다 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- 화면 꺼짐 생존(60초 규칙) — 포그라운드 서비스 health 타입 필수 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="VitAlGuard"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@android:style/Theme.DeviceDefault">

        <!-- 폰 없이 단독 동작 선언 — LTE 단독 전송 계획의 전제 -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".HrForegroundService"
            android:exported="false"
            android:foregroundServiceType="health" />

        <!-- 수집 본체 — 생체(health) + GPS(location) 를 한 서비스가 든다 -->
        <service
            android:name=".CollectorService"
            android:exported="false"
            android:foregroundServiceType="health|location" />
    </application>
</manifest>
