<?xml version="1.0" encoding="utf-8"?>
<!-- 워치 단독 실측 프로브 — 권한은 Wear OS 6(API 36) 신·구 병기 (context-notes R-07) -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />

    <!-- 구권한: targetSdk 33~35 기기용. 36부터는 아래 health 권한이 대체한다 -->
    <!-- ⚠ maxSdkVersion 을 걸면 API 36+ 기기(이 워치는 **37**)에서 선언 자체가 사라지고,
         순정 SensorManager 의 TYPE_HEART_RATE 가 조용히 죽는다 — 08-25 실기에서 심박이
         값이 비어 있던 원인이 정확히 이것이다(dumpsys 에 BODY_SENSORS 항목 자체가 없었다).
         health 권한은 Health Services·삼성 SDK 용이고, **순정 센서는 여전히 BODY_SENSORS 를 본다.**
         둘 다 선언한다. -->
    <uses-permission android:name="android.permission.BODY_SENSORS" />
    <uses-permission android:name="android.permission.BODY_SENSORS_BACKGROUND" />
    <!-- 신권한: Wear OS 6(API 36)+ -->
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND" />
    <!-- 삼성 SDK 의 SpO₂·피부온 트래커가 요구하는 권한. **선언이 없으면 `pm grant` 가 조용히
         무시된다** — 08-25 실기에서 PERMISSION_ERROR 의 원인이 정확히 이것이었다.
         READ_HEART_RATE 만 선언돼 있어 그 하나만 부여됐다. -->
    <uses-permission android:name="android.permission.health.READ_OXYGEN_SATURATION" />
    <uses-permission android:name="android.permission.health.READ_SKIN_TEMPERATURE" />
    <!-- 활동 3종(걸음·층·칼로리) — Health Services PassiveMonitoring 이 요구한다.
         ⚠ 선언이 없으면 콜백이 **조용히 안 온다**(예외도 로그도 없다). 08-25 실기에서
         걸었는데 활동 로그 0건이었던 원인이 이것이다. READ_OXYGEN_SATURATION 때와 같은 함정. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_FLOORS_CLIMBED" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />

    <!-- 업로드(LTE 직결) — INTERNET 없이는 첫 POST 부터 SecurityException 이고, runCatching 이
         그것을 -1(네트워크 오류)로 삼켜 30초 재시도 무한루프가 된다(08-24 외부 리뷰가 잡음).
         ACCESS_NETWORK_STATE 는 실측 ⑧ 의 TRANSPORT_CELLULAR 바인딩에 필요하다 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

    <!-- GPS — 생체 + 위치 송출이 목표.
         ⚠ **"백그라운드 위치는 FGS location 타입으로 충족한다" 는 틀렸다**(09-01 워치9 실측으로 반증).
         ACCESS_FINE_LOCATION 은 '사용 중에만' 권한이라, 앱이 포그라운드가 아닌 상태에서 서비스가
         시작되면(부팅·재설치·OS 의 sticky 재시작) location 타입 승격이 SecurityException 으로 거부되고
         **앱이 죽는다**. 그래서 ACCESS_BACKGROUND_LOCATION 을 선언한다.
         ⚠ 이 권한은 **다른 위치 권한과 같은 요청에 넣으면 안 된다** — Android 11+ 는 그런 요청을
         통째로 거절한다. 부여는 설정 화면(항상 허용) 또는 `pm grant` 로 따로 한다. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- 화면 꺼짐 생존(60초 규칙) — 포그라운드 서비스 health 타입 필수 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 전송 tick 의 정확 알람(08-29 R-32) — 화면 소등 suspend 에서 uptimeMillis 가 서므로 알람으로 CPU 를 깨운다.
         API 33+ 는 USE_EXACT_ALARM(설치 시 부여 · 사이드로드라 Play 정책 무관), 31~32 는 SCHEDULE_EXACT_ALARM(사용자 승인).
         ⚠ 둘 다 없으면 setExact 가 SecurityException — CollectorService.scheduleTick 이 30초 창 부정확 알람으로 물러선다. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 재부팅 뒤 수집 자동 복구(09-01 사용자 지시) — 이 선언이 없으면 BOOT_COMPLETED 가 아예 안 온다. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:label="VitAlGuard"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@android:style/Theme.DeviceDefault">

        <!-- 폰 없이 단독 동작 선언 — LTE 단독 전송 계획의 전제 -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <!-- ★ 화면 회전 고정(09-01 사용자 지시) — 손목을 움직이면 화면이 따라 돌던 현상.
             기기 자동회전이 켜져 있고(accelerometer_rotation=1) 액티비티가 방향을 안 정해 센서를
             그대로 따랐다(실측: 착용 중 mRotation=ROTATION_180 = 뒤집힘).
             ⚠ `portrait` 가 아니라 `nosensor` 다 — portrait 는 회전 0 으로 못박아, 반대 손목·버튼
             방향으로 쓰는 사용자의 기기 기본 방향까지 뒤집어 버린다. nosensor 는 **기기 기본 방향을
             그대로 쓰되 센서만 무시**하므로 어느 손목이든 바로 서고 움직여도 안 돈다. -->
        <activity
            android:name=".MainActivity"
            android:screenOrientation="nosensor"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".HrForegroundService"
            android:exported="false"
            android:foregroundServiceType="health" />

        <!-- 재부팅·재설치 뒤 수집을 스스로 되살린다. 종전엔 앱 소유 리시버가 **0개**라 둘 다에서
             수집이 조용히 멈췄고, 화면은 평소와 같아 아무도 몰랐다(09-01 워치8 재설치 실측).
             ⚠ exported=true 가 필요하다 — 이 둘은 시스템만 보낼 수 있는 protected broadcast 라
             외부 앱이 흉내낼 수 없다. 다른 액션으로 넓히면 Android 12+ 의 백그라운드 FGS 제한에
             걸린다(이 둘은 면제 대상). -->
        <receiver
            android:name=".RestartReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- 수집 본체 — 생체(health) + GPS(location) 를 한 서비스가 든다 -->
        <service
            android:name=".CollectorService"
            android:exported="false"
            android:foregroundServiceType="health|location" />
    </application>
</manifest>
