{
  "name": "@safetymonitor/dashboard-web",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "dev:local-hyperclova": "node --env-file=../../../../../.env.local ./node_modules/next/dist/bin/next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"lib/**/*.test.ts\" \"app/**/*.test.ts\"",
    "graph": "depcruise app lib --output-type dot | node scripts/render-dot-svg.mjs - docs/graph/dependency-graph.svg",
    "graph:archi": "depcruise app lib --output-type archi | node scripts/render-dot-svg.mjs - docs/graph/architecture.svg",
    "graph:cycles": "depcruise app lib --output-type err-long > docs/graph/cycles.txt; depcruise app lib --output-type json > docs/graph/cycles.json",
    "graph:check": "node scripts/graph-check.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1075.0",
    "@aws-sdk/s3-request-presigner": "^3.1075.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@paper-design/shaders-react": "^0.0.76",
    "@safetymonitor/analyzers": "workspace:*",
    "@safetymonitor/schemas": "workspace:*",
    "exceljs": "^4.4.0",
    "framer-motion": "^13.1.1",
    "next": "^15.5.21",
    "pdfjs-dist": "^6.2.108",
    "pg": "^8.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0",
    "uqr": "^0.1.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^9.16.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0"
  }
}
