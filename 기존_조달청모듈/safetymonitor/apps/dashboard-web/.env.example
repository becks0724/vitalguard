# SafetyMonitor 대시보드 환경변수 예시 — 복사 후 .env.local 로 사용
# (.env.local 은 .gitignore 에 의해 커밋 제외)

# PostgreSQL 연결 (pull 이후 필수) — 팀에서 공유받은 연결 문자열 사용
# 예: postgresql://vitalguard:비밀번호@project-db-campus.smhrd.com:3310/vitalguard?sslmode=disable
DATABASE_URL=

# 관리자 메뉴 (CSV 내보내기) 자격
# - ADMIN_PASSWORD 미설정 시 관리자 인증은 항상 거부(fail-closed) — 소스에 동작 기본값 없음
# - 반드시 .env.local 에 강한 비밀번호를 직접 설정. 실 서비스 화 시 NextAuth/Cognito 전환
ADMIN_ID=admin
ADMIN_PASSWORD=

# AED NFC 점검 태그 서명 비밀 — 서명된 태그에서 온 점검 제출만 수락(임의 인터넷 POST 위조 차단)
# - 미설정 시 dev fallback(소스 노출 시 무력) → 상용화 시 반드시 강한 임의값으로 설정
AED_INSPECT_SECRET=

# 작업자 생체 GET 응답의 민감 PII(보호자 이름·전화, 위·경도) 노출 여부
# - 미설정/false: 기본 비노출(공개 터널 fail-safe). SOS 모달 보호자 연락·지도 링크 비활성
# - true: 신뢰된 로컬 데모에서만 명시 opt-in (전체 SOS 기능 활성)
MOCK_VITAL_EXPOSE_PII=

# KOSHA 공공데이터포털 OpenAPI 인증키 (건설현장 안전 신호등 + 사고사망 게시판)
# - 발급: data.go.kr 로그인 → 활용신청(자동승인) → 인증키 복사
# - 미설정 시 두 패널은 샘플(목업) 데이터로 동작 (데모 무중단)
# - Decoding 키(원문) 사용. 절대 커밋 금지(.env.local 에만)
KOSHA_SERVICE_KEY=

# 기상청(1360000) 기상특보 API 인증키 — 현장환경 '기상특보' 항목(GPS 기반)
# - 발급: data.go.kr → "기상청_기상특보 조회서비스" 활용신청(자동승인) → 일반 인증키(Decoding)
# - data.go.kr 일반 인증키는 계정 공통이라 KOSHA 키와 동일할 수 있음
#   → 동일하면 KMA_SERVICE_KEY 를 비워둬도 KOSHA_SERVICE_KEY 로 자동 폴백
# - 엔드포인트는 코드 고정(apis.data.go.kr/1360000/WthrWrnInfoService) → 별도 입력 불필요
KMA_SERVICE_KEY=

# 공공데이터 병의원 정보(E-Gen) API 인증키 — 인근 병원 각 항목의 '연락처·진료시간' 보강
# - 발급: data.go.kr → "국립중앙의료원_전국 병·의원 찾기 서비스"(B552657/HsptlAsembySearchService) 활용신청
# - data.go.kr 일반 인증키는 계정 공통이라 KOSHA/KMA 키와 동일할 수 있음
#   → 비워두면 KOSHA_SERVICE_KEY / KMA_SERVICE_KEY 로 자동 폴백(별도 시크릿 불필요)
# - ★ 위 서비스 활용신청 승인 전에는 게이트웨이 403 → 보강 no-op(네이버 결과 그대로, 응급실만 "24시간 진료" 표기)
# - 엔드포인트는 코드 고정(apis.data.go.kr/B552657/HsptlAsembySearchService) → 별도 입력 불필요
EGEN_SERVICE_KEY=

# YouTube Data API v3 키 — '특보 영상' 패널(기상특보/예비특보 발생 시 관련 영상 자동 검색)
# - 발급: Google Cloud Console → API 및 서비스 → YouTube Data API v3 사용 설정 → 사용자 인증 정보(API 키)
# - 미설정 시 패널은 "API 키 미설정" 안내만 표시(대시보드 무중단)
# - 쿼터 기본 10,000/일(검색 1회=100) → 특보 종류별 3시간 캐시로 절약
YOUTUBE_API_KEY=

# 특보 영상 채널 한정 — 우선순위 ① channelId(엄격) ② 뉴스사 이름 ③ 일반
#
# ① 공식 채널 ID 화이트리스트(channelId, 쉼표구분 UC... ID). 설정 시 이 채널만 엄격 검색.
#    채널 ID 확인: 채널 페이지 또는 channels.list?forHandle=@핸들 → items[].id (UC...)
YOUTUBE_OFFICIAL_CHANNEL_IDS=
#
# ② 주요 뉴스사 channelTitle 이름 필터(부분일치, 쉼표구분). ① 미설정 시 이 이름들의 보도만 통과.
#    미설정 시 기본값 = KBS,SBS,MBC,JTBC,YTN,연합뉴스,채널A,channelA,Yonhap (코드 내장)
#    검색어는 기상 재난 종류(태풍/강풍/호우/장마/침수 등 특보 종류)로 자동 생성, 전국(KR) 대상.
YOUTUBE_NEWS_CHANNEL_NAMES=

# CCTV AI 스트림 API 베이스(브라우저에서 호출) — CctvQuadView 가 읽음(NEXT_PUBLIC_ 접두사라 클라이언트 노출)
# - 미설정 시 기본값 http://localhost:8000 (발표 PC 본인만 표시)
# - 팀원 공유 시 권장값 /ai-cctv (same-origin 프록시 경유 → :3000 터널 하나로 전달)
NEXT_PUBLIC_AI_CCTV_API=

# CCTV same-origin 프록시(/ai-cctv) 가 전달할 발표 PC 의 CCTV 백엔드 오리진 — ai-cctv 라우트가 읽음
# - 미설정 시 기본값 http://localhost:8000
AI_CCTV_ORIGIN=

# 관리자 회원가입 이메일 인증 — Resend HTTP API 발송 키
# - 발급: resend.com → API Keys → 생성 후 복사. 발신 도메인 검증 시 임의 수신자 발송 가능
# - 미설정 시: 개발 환경은 콘솔/화면에 인증코드 노출(devCode, 데모용), 운영은 발송 실패
# - 라이브 반영 시 Secret Manager 에 등록 후 Cloud Run --update-secrets 로 주입
RESEND_API_KEY=
# 인증 메일 발신 주소 — Resend 검증 도메인 필요. 미설정 시 onboarding@resend.dev(가입 계정 본인 메일로만)
EMAIL_FROM=

# 캘린더 미디어 스토리지 — 네이버 클라우드 Object Storage(S3 호환) · 클라우드 브릿지(앱 OCR → 캘린더)
# - 발급: NCP 콘솔 → Object Storage 버킷 생성(비공개) + 마이페이지 → 인증키 관리 → API 인증키(Access/Secret)
# - 셋 다 설정해야 활성. 미설정 시 /api/calendar/media/upload-url 은 503(데모 무중단)
# - 엔드포인트/리전은 한국 기본값(kr.object.ncloudstorage.com / kr-standard) 코드 내장 → 다른 리전만 덮어씀
# - 절대 커밋 금지(.env.local 에만). 라이브 반영 시 Secret Manager 등록 후 Cloud Run --update-secrets
NCP_ACCESS_KEY=
NCP_SECRET_KEY=
NCP_BUCKET=
# (선택) 다른 리전/엔드포인트 사용 시에만 설정
NCP_ENDPOINT=
NCP_REGION=

# 앱(현장 단말) 미디어 업로드 토큰 — iOS 앱이 캘린더 미디어를 업로드할 때 Authorization: Bearer <값>
# - 관리자 세션이 없는 앱이 /api/calendar/media/upload-url 과 POST /api/calendar/media 를 호출하도록 허용
# - 미설정 시 앱 업로드 경로는 항상 거부(fail-closed). 강한 임의값(예: openssl rand -base64 32) 권장
# - 절대 커밋 금지(.env.local + 앱 빌드에만). 라이브는 Secret Manager 등록
APP_UPLOAD_TOKEN=

# 앱 로그인 JWT 서명 시크릿 — POST /api/app-auth/login 이 발급하는 앱 토큰(HMAC-SHA256)의 서명 키
# - 미설정 시 앱 로그인은 항상 503(app_auth_not_configured, fail-closed)
# - 강한 임의값(예: openssl rand -base64 48) 권장. 절대 커밋 금지. 라이브는 Secret Manager 등록
# - (겸용) 관제 대시보드 세션 JWT 서명 키도 이 값에서 파생(무상태 세션 — 재배포/다중 인스턴스에도 유지).
APP_JWT_SECRET=

# 관제 대시보드 세션 만료(분) — 무상태 세션 JWT 의 TTL. 미설정 시 기본 480(8시간).
# - 만료 3분 전 "세션 연장" 팝업 표시. 테스트로 팝업을 빨리 보려면 짧게(예: 5) 두면 됨(재빌드 불필요, env 만).
# - 라이브 조정 = gcloud run services update --update-env-vars DASHBOARD_SESSION_TTL_MIN=<분> (즉시 새 리비전)
DASHBOARD_SESSION_TTL_MIN=

# 네이버 지역검색(NCP NAVER API HUB) — 현장 GPS/지역 기준 진료과별 병원 검색(현황 요약 캐러셀 + SOS 응급 섹션)
# - 발급: NCP 콘솔 → Application Services → NAVER API HUB → Application 등록(사용 API "검색") → 인증 정보의 Client ID/Secret
# - 호출: GET https://naverapihub.apigw.ntruss.com/search/v1/local, 헤더 X-NCP-APIGW-API-KEY-ID(=Client ID)/X-NCP-APIGW-API-KEY(=Client Secret)
# - 둘 다 설정해야 활성. 미설정 시 /api/hospitals 는 configured:false(패널이 "키 미설정" 안내, 데모 무중단)
# - 지역검색은 좌표를 안 받으므로 현장 주소에서 시·구를 뽑아 "지역명 진료과"로 검색, 거리는 반환 좌표(mapx/mapy=WGS84×1e7)로 계산
# - 절대 커밋 금지(.env.local 에만). 라이브는 Secret Manager 등록 후 Cloud Run --update-secrets
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
