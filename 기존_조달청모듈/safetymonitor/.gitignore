# SafetyMonitor 루트 .gitignore — Node / iOS / AWS CDK 공통 패턴

# ─── Node / pnpm ──────────────────────────────
node_modules/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.yarn/

# ─── TypeScript / 빌드 산출물 ─────────────────
dist/
build/
.next/
out/
*.tsbuildinfo
.turbo/

# ─── 테스트 / 커버리지 ────────────────────────
coverage/
.nyc_output/

# ─── 환경변수 / 비밀 ──────────────────────────
.env
.env.local
.env.*.local
*.pem
*.key
*.cer
*.p12
*.mobileprovision
credentials.json
secrets.json

# ─── iOS / Xcode ──────────────────────────────
xcuserdata/
DerivedData/
*.xcuserstate
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/
build/
.swiftpm/
Package.resolved
Pods/
*.ipa
*.dSYM.zip
*.dSYM

# ─── AWS CDK ──────────────────────────────────
cdk.out/
cdk.context.json
.cdk.staging/

# ─── Flutter / Dart ───────────────────────────
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
.fvm/
build/
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
android/.gradle/
android/local.properties
android/captures/
android/key.properties
*.g.dart
*.freezed.dart

# ─── Python / ML (ml/) ────────────────────────
.venv/
__pycache__/
*.pyc
*.pyo

# ─── 에디터 / OS ──────────────────────────────
.DS_Store
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo
*~
Thumbs.db

# ─── Claude Code 개인 설정 ─────────────────────
# 팀 공유 권한(.claude/settings.json)은 추적, 개인 권한(.local.json)은 제외
.claude/settings.local.json
# 로컬 Claude Code 스킬(도구 디렉터리) — 프로젝트 코드와 무관, 추적 제외
.claude/skills/

# ─── 런타임 영속 데이터 (mock receiver SQLite + dev/cloudflared log) ──
.runtime/
*.sqlite
*.sqlite-journal
safetymonitor.db
safetymonitor.db-shm
safetymonitor.db-wal

# ─── 검증 산출물 (Playwright MCP 스냅샷/스크린샷/콘솔 로그) ──
.playwright-mcp/

# ─── 외형 스냅샷 HTML (SingleFile 팀 공유용 정지 산출물) ──
# 세션마다 재생성되는 일회성 공유물 — 소스 아님, 히스토리 누적 방지 (로컬 보존)
demo/

# ─── 의존성 그래프 — 그림은 재생성물이라 커밋하지 않는다 (2026-08-21) ──
# 이유는 용량이 아니라 **diff 가 무의미**하다는 것이다. 리뷰에서 SVG 변경분을 읽을 사람은 없고,
# 의존이 하나만 늘어도 graphviz 가 전역 재배치를 해서 628KB 파일 전체가 바뀐 것으로 잡힌다.
# git 은 지운 객체도 이력에 남기므로 재생성마다 그 무게가 영구 누적된다.
# ⚠ 같은 이유로 `cycles.json`(384KB · 286 모듈 전체를 담는다)도 뺀다 —
#   사람이 읽을 리포트는 `cycles.txt`(501B)이고, CI 판정은 `pnpm graph:check` 가 그때그때 만든다.
# 재생성 = pnpm graph · graph:archi · graph:cycles
apps/dashboard-web/docs/graph/*.svg
apps/dashboard-web/docs/graph/cycles.json

# ─── CDK 인플레이스 컴파일 산출물 (2026-08-25) ──
# backend/infrastructure 의 tsconfig 에는 outDir 이 없어 tsc 가 **소스 옆에** .js/.d.ts 를 낳는다.
# 위 `dist/`·`build/` 규칙이 이것을 못 걸러 4개가 커밋돼 있었다(레포 전체에서 유일한 사례).
# 실행 경로는 `.ts` 다 — cdk.json 이 `npx ts-node --prefer-ts-exts bin/app.ts` 로 부르고,
# cdk.json 의 watch 도 `**/*.js`·`**/*.d.ts` 를 제외 대상으로 명시한다. 재생성 = pnpm build.
# ⚠ package.json 의 `bin: bin/app.js` 는 이 산출물을 가리키지만 private 패키지라 실사용 경로가 아니다.
backend/infrastructure/bin/*.js
backend/infrastructure/bin/*.d.ts
backend/infrastructure/lib/*.js
backend/infrastructure/lib/*.d.ts
