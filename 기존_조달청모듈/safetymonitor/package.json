{
  "name": "safetymonitor",
  "version": "0.0.1",
  "private": true,
  "description": "SafetyMonitor (가칭 IndusView) — 산업 현장 작업자 생체 모니터링 프로토타입 모노레포",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/* --filter=./apps/dashboard-web build",
    "test": "pnpm -r --filter=./packages/* --filter=./apps/dashboard-web test",
    "lint": "pnpm -r --filter=./packages/* --filter=./apps/dashboard-web lint",
    "typecheck": "pnpm run prepare:packages && pnpm -r --filter=./packages/* --filter=./apps/dashboard-web typecheck",
    "dev:web": "pnpm --filter @safetymonitor/dashboard-web dev",
    "mock:publish": "node scripts/mock-publish.mjs",
    "prepare:packages": "pnpm --filter @safetymonitor/schemas build && pnpm --filter @safetymonitor/analyzers build"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
