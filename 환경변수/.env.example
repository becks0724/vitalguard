# ═══════════════════════════════════════════════════════════════════
#  VitAlGuard / safetymonitor — 환경변수 템플릿
# ═══════════════════════════════════════════════════════════════════
#
#  이 파일은 "설명서"다. 프로그램은 이 파일을 읽지 않는다.
#  실제 값은 같은 폴더의 .env.local 에 넣는다.
#
#      환경변수/.env.local   ← 실값. git 제외. 여기만 편집한다.
#      환경변수/.env.example ← 이 파일. 값 없이 키·설명만. git 커밋됨.
#
#  Next.js 는 apps/dashboard-web/.env.local 을 읽는데,
#  그 파일은 ../../../../환경변수/.env.local 로 가는 심링크다.
#
#  라이브(Cloud Run)는 이 파일들과 무관하게 GCP Secret Manager 를 쓴다.
#      gcloud run services update vitalguard-dashboard --region asia-northeast3 \
#        --update-secrets KEY=SECRET_NAME:latest
#      ⚠ 시크릿은 인스턴스 시작 시 1회만 읽는다. 리비전을 갈지 않으면 안 바뀐다.
#
#  코드가 읽는 키 = 63개 (2026-09-11 전수 확인)
#  [필수] 없으면 해당 기능이 죽는다 / [선택] 기본값 있음 / [스크립트] 앱 런타임 아님
# ═══════════════════════════════════════════════════════════════════


# ───────────────────────────────────────────────────────────────────
#  1. 데이터베이스
# ───────────────────────────────────────────────────────────────────

# [필수] PostgreSQL 연결 문자열. 미설정 시 데모모드(목업 데이터)로 동작.
# TLS 파라미터를 프로덕션과 동일하게 유지할 것 — 평문 sslmode=disable 금지.
# ⚠ pg 8.x 는 sslmode=require 단독을 verify-full 로 격상시켜 자체서명 서버 접속을 거부한다.
#   반드시 uselibpqcompat=true 를 함께 쓴다. 근거는 lib/db.ts 주석.
# 예: postgresql://user:pw@host:3310/db?uselibpqcompat=true&sslmode=require
DATABASE_URL=


# ───────────────────────────────────────────────────────────────────
#  2. 인증 · 세션
# ───────────────────────────────────────────────────────────────────

# [필수] 관제 대시보드 관리자 계정. lib/admin-auth.ts
# ADMIN_PASSWORD 미설정 시 관리자 인증은 항상 거부(fail-closed) — 소스에 기본값 없음.
ADMIN_ID=
ADMIN_PASSWORD=

# [필수] 앱 로그인 JWT 서명 키 — POST /api/app-auth/login 이 발급하는 토큰(HMAC-SHA256).
# 관제 대시보드 세션 JWT 서명 키도 이 값에서 파생된다(무상태 세션).
# 미설정 시 앱 로그인 503(app_auth_not_configured). 생성: openssl rand -base64 48
# ⚠ 이 값을 바꾸면 이미 발급된 앱 토큰이 전부 무효가 된다.
APP_JWT_SECRET=

# [필수] 앱(현장 단말) 미디어 업로드 토큰 — Authorization: Bearer <값>
# 관리자 세션 없는 앱이 /api/calendar/media/* 를 호출하도록 허용. 미설정 시 fail-closed.
# 생성: openssl rand -base64 32
APP_UPLOAD_TOKEN=

# [선택] 관제 대시보드 세션 만료(분). 미설정 시 480(8시간).
# 만료 3분 전 "세션 연장" 팝업. 테스트로 빨리 보려면 5 등으로 짧게.
DASHBOARD_SESSION_TTL_MIN=

# [필수] AED NFC 점검 태그 서명 비밀 — lib/aed-sign.ts
# 서명된 태그에서 온 점검 제출만 수락(임의 인터넷 POST 위조 차단).
# ★ fail-closed — 미설정 시 소스 상수로 폴백하지 않고 서명·검증을 거부한다(라우트 500).
#   즉 위조 위험은 없고, 대신 AED 점검 기능 자체가 꺼진다.
# 현재 로컬·라이브 모두 미설정 → AED 점검 비활성 상태. 켜려면 강한 임의값을 넣는다.
#   생성: openssl rand -base64 32
# ⚠ 값을 바꾸면 이미 발행된 NFC 태그의 서명이 전부 무효가 된다(태그 재발행 필요).
AED_INSPECT_SECRET=

# [필수] Cloud Scheduler → 크론 라우트 인증 키 — app/api/kma-warning, app/api/disaster-msg
# ⚠ 값 생성 시 개행 주의: openssl rand -hex 32 > file 은 끝에 개행을 넣어 401 을 유발한다.
#   printf '%s' 로 넣을 것.
CRON_SECRET=

# [필수] 구글 OAuth 로그인 — lib/google-oauth.ts
# 발급: Google Cloud Console → API 및 서비스 → 사용자 인증 정보 → OAuth 클라이언트 ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# ───────────────────────────────────────────────────────────────────
#  3. 공공데이터포털 (data.go.kr) — 계정 공통 일반 인증키(Decoding)
#     같은 계정이면 아래 키들이 서로 같을 수 있다. 폴백 규칙은 각 항목 참조.
# ───────────────────────────────────────────────────────────────────

# [필수] KOSHA 안전 신호등 + 사고사망 게시판
# 발급: data.go.kr → 15139182(안전신호등)·15119137(사고사망) 각각 활용신청(자동승인)
#       → 마이페이지 → Open API → 일반 인증키(Decoding) 복사
# 미설정 시 두 패널은 샘플(목업)로 동작 — 데모는 무중단이라 조용히 가짜가 된다.
KOSHA_SERVICE_KEY=

# [필수] 기상청(1360000) 기상특보 + 태풍정보 — 현장환경 '기상특보'(GPS 기반)
# 태풍은 별도 활용신청 승인 필요. 비워두면 KOSHA_SERVICE_KEY 로 자동 폴백.
# 엔드포인트는 코드 고정(apis.data.go.kr/1360000/WthrWrnInfoService).
KMA_SERVICE_KEY=

# [선택] E-Gen 국립중앙의료원 병·의원 정보 — 인근 병원 '연락처·진료시간' 보강
# 발급: data.go.kr → B552657/HsptlAsembySearchService 활용신청
# 비워두면 KOSHA / KMA 키로 자동 폴백. 승인 전에는 게이트웨이 403 → 보강 no-op.
EGEN_SERVICE_KEY=

# [필수] 긴급재난문자 — app/lib/disaster-msg-api.ts
# LINK형이라 실호출은 safetydata.go.kr(V2/api/DSSP-IF-00247) 로 넘어간다.
# ⚠ 인증키 만료 2027-07-31. 만료돼도 목업 폴백이라 화면은 200 이고 내용만 가짜가 된다.
SAFETYDATA_SERVICE_KEY=

# [필수] 나라장터 4종(계약·낙찰·종합쇼핑몰·입찰공고) 공용 — app/lib/g2b.ts, g2b-shop.ts
G2B_SERVICE_KEY=

# [필수] 국세청 사업자등록정보 진위확인·상태조회(15081808) — app/lib/nts.ts
NTS_SERVICE_KEY=


# ───────────────────────────────────────────────────────────────────
#  4. 외부 API
# ───────────────────────────────────────────────────────────────────

# [선택] 법제처 국가법령정보 OC — app/lib/moleg.ts (안전관리비 고시 개정 감지 · 별표1 요율 파싱)
# open.law.go.kr 가입 후 이메일 ID 부분. 예: 279881795+rlaxorhs77-eng@users.noreply.github.com → rlaxorhs77
# ★ 코드에 기본값 "rlaxorhs77" 이 박혀 있어 미설정이어도 동작한다(라이브가 그 상태).
#   OC 는 공개 URL 파라미터라 비밀이 아니다 — 계정을 바꿀 때만 여기에 넣는다.
# 법제처는 OC 와 "Referer 헤더 = 신청 시 등록한 도메인" 을 함께 대조한다(2026-07-10 실호출 확인).
MOLEG_OC=

# [필수] VWorld 지도 — app/lib/vworld.ts
# 발급: vworld.kr → 오픈API → 인증키 발급(도메인 등록 필요)
VWORLD_KEY=

# [필수] 네이버 지역검색(NCP NAVER API HUB) — 진료과별 병원 검색
# 발급: NCP 콘솔 → Application Services → NAVER API HUB → Application 등록(사용 API "검색")
# 둘 다 있어야 활성. 미설정 시 /api/hospitals 는 configured:false(패널이 안내만 표시).
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=

# [선택] YouTube Data API v3 — '특보 영상' 패널(기상특보 발생 시 관련 영상 검색)
# 발급: Google Cloud Console → YouTube Data API v3 사용 설정 → API 키
# 쿼터 10,000/일(검색 1회=100) → 특보 종류별 3시간 캐시로 절약.
YOUTUBE_API_KEY=

# [선택] 특보 영상 채널 한정 — 우선순위 ① channelId ② 뉴스사 이름 ③ 일반
# ① 공식 채널 ID 화이트리스트(쉼표구분 UC... ID). 설정 시 이 채널만 엄격 검색.
YOUTUBE_OFFICIAL_CHANNEL_IDS=
# ② channelTitle 부분일치 필터(쉼표구분). ① 미설정 시 적용.
#    미설정 시 코드 내장 기본값 = KBS,SBS,MBC,JTBC,YTN,연합뉴스,채널A,channelA,Yonhap
YOUTUBE_NEWS_CHANNEL_NAMES=

# [선택] 관리자 회원가입 이메일 인증 — Resend HTTP API
# 발급: resend.com → API Keys. 미설정 시 개발은 화면에 인증코드 노출(devCode), 운영은 발송 실패.
RESEND_API_KEY=
# 발신 주소. Resend 검증 도메인 필요. 미설정 시 onboarding@resend.dev(가입 계정 본인 메일로만).
EMAIL_FROM=


# ───────────────────────────────────────────────────────────────────
#  5. LLM — 배치 어시스턴트 · 위험작업 태깅
# ───────────────────────────────────────────────────────────────────

# [선택] CLOVA Studio — 이 저장소의 유일한 LLM. 두 곳이 같은 키·같은 모델을 쓴다.
#   · 배치 어시스턴트     app/api/assignment/chat/route.ts
#   · 위험작업 태깅       app/lib/risk-tagging.ts · app/lib/procure-risk-tags.ts
#     (2026-09-11 Anthropic → CLOVA 전환. 공고 텍스트가 국외로 나가지 않는다)
# ★ 셋은 같은 키를 찾는 폴백 체인이다. 하나만 채우면 되고, 셋 다 넣을 필요가 없다.
#      CLOVASTUDIO_API_KEY ?? CLOVA_API_KEY ?? HYPERCLOVA_API_KEY
#   전부 비면 배치 어시스턴트는 폴백, 태깅은 룰 키워드 매칭으로 떨어진다.
#   라이브 폴백 원인이 prod 시크릿 미등록이었던 이력 있음.
CLOVA_API_KEY=
CLOVASTUDIO_API_KEY=
HYPERCLOVA_API_KEY=
# [선택] 모델명. 미설정 시 코드 기본값.
CLOVA_MODEL=

# 위험작업 태깅(app/lib/risk-tagging.ts · procure-risk-tags.ts)은 2026-09-11 부터
# 위 CLOVA 키를 쓴다. 별도 키가 필요 없다.
#   호출 경로: /api/g2b/notice/[id] · /api/assignment/task-doc
#   키가 없으면 룰 키워드 매칭으로 폴백하므로 기능 자체는 동작한다.
# (전환 전에는 ANTHROPIC_API_KEY 로 Claude haiku 를 호출했다 — 그 키는 이제 쓰지 않는다.)


# ───────────────────────────────────────────────────────────────────
#  6. CCTV · 엣지(젯슨)
# ───────────────────────────────────────────────────────────────────

# [선택] CCTV AI 스트림 API 베이스 — 브라우저에서 호출(NEXT_PUBLIC_ 이라 클라이언트 노출)
# ⚠ NEXT_PUBLIC_* 는 빌드타임에 인라인된다. Cloud Run env 를 바꿔도 안 바뀌고 재빌드가 필요하다.
#   라이브 주입: gcloud builds submit --config cloudbuild.dashboard.yaml \
#                  --substitutions=_AI_URL=...,_CAM03_GATE=...
# 미설정 시 http://localhost:8000. 팀원 공유 시 권장값 /ai-cctv (same-origin 프록시).
NEXT_PUBLIC_AI_CCTV_API=

# [선택] CAM-03 게이트(젯슨 직결) 주소 — app/components/CctvQuadView.tsx
# 위와 같은 빌드타임 변수. 미설정 시 CAM-03 도 NEXT_PUBLIC_AI_CCTV_API 경로를 쓴다.
NEXT_PUBLIC_CAM03_GATE_API=

# [선택] same-origin 프록시(/ai-cctv)가 전달할 CCTV 백엔드 오리진 — 서버 측 런타임 변수.
# 미설정 시 http://localhost:8000
AI_CCTV_ORIGIN=

# [필수] CAM-03 게이트 티켓 서명 — lib/cctv-ticket.ts
# 젯슨 게이트가 검증하는 단기 티켓. KID 는 키 회전용 식별자, TTL 은 유효시간(초).
CCTV_TICKET_KEY=
CCTV_TICKET_KID=
CCTV_TICKET_TTL_SEC=

# [선택] 낙상 폴링 주기(ms) — lib/cctv-fall-poller.ts. 미설정 시 코드 기본값.
CCTV_FALL_POLL_MS=

# [선택] 가스포드 텔레메트리 토큰 강제 — app/api/gaspod/telemetry/route.ts
# true 면 토큰 없는 전송을 401 로 거부. 2026-08-13 강제 ON 실측 완료.
GASPOD_REQUIRE_TOKEN=


# ───────────────────────────────────────────────────────────────────
#  7. 알림 — 텔레그램
# ───────────────────────────────────────────────────────────────────

# [필수] 경보 발송 — lib/telegram.ts
# 발급: @BotFather 로 봇 생성 → 토큰. CHAT_ID 는 대상 채팅방 ID.
# 미설정 시 sendTelegramMessage 가 "skipped" 를 반환한다(조용히 안 나간다).
# ⚠ 국외 이전이므로 이름 마스킹·수치 제외 규칙을 지킬 것.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=


# ───────────────────────────────────────────────────────────────────
#  8. 스토리지 — 네이버 클라우드 Object Storage (캘린더 미디어)
# ───────────────────────────────────────────────────────────────────

# [선택] 발급: NCP 콘솔 → Object Storage 버킷 생성(비공개)
#              + 마이페이지 → 인증키 관리 → API 인증키(Access/Secret)
# 셋 다 있어야 활성. 미설정 시 /api/calendar/media/upload-url 은 503(데모 무중단).
NCP_ACCESS_KEY=
NCP_SECRET_KEY=
NCP_BUCKET=
# [선택] 다른 리전·엔드포인트를 쓸 때만. 기본값은 코드 내장(kr.object.ncloudstorage.com / kr-standard).
NCP_ENDPOINT=
NCP_REGION=


# ───────────────────────────────────────────────────────────────────
#  9. CODEF — 전자세금계산서 발급사실 확인   ★ 미사용 · 채우지 말 것
# ───────────────────────────────────────────────────────────────────
#  2026-09-11 미사용 결정. 키를 비워두면 mock 으로 강등돼 화면은 정상 동작한다
#  (app/lib/tax-invoice-issuance.ts — credentials() 가 null 이면 mockIssuance()).
#
#  안 쓰는 이유 (docs/opendata-gap.md 2026-08-10 조사):
#   · 개인 실명 간편인증(loginType=5) 필요 — 사람이 카카오톡 승인을 눌러야 해서
#     관제 자동화가 원천 불가하다. 타임아웃 280초.
#   · 그렇게 얻는 값이 resAuthenticity 불리언 1개뿐이다.
#   · 팀원 1인의 실명·전화번호·생년월일을 env 에 넣어야 한다(개인정보).
#
#  다시 쓰려면 developer.codef.io 데모버전(실데이터·일 100회 무료) 가입 후
#  아래를 전부 채운다. 하나라도 비면 실호출로 전환되지 않는다.
# ───────────────────────────────────────────────────────────────────

CODEF_CLIENT_ID=
CODEF_CLIENT_SECRET=
# 개발가이드 '제3자 전자(세금)계산서 발급사실 조회' 상품의 URL 경로. 예: /v1/kr/public/nt/...
CODEF_TAXINVOICE_PATH=
# 기본 https://development.codef.io (데모). 정식 전환 시 https://api.codef.io
CODEF_API_BASE=

# 간편인증 실명 정보(팀원 1인) — 조회 시 해당 인의 카카오톡 승인이 필요하다.
CODEF_AUTH_NAME=
CODEF_AUTH_PHONE=
CODEF_AUTH_BIRTH=
# 1 = 카카오톡
CODEF_AUTH_LOGIN_LEVEL=
# PASS 인증 시에만. 0=SKT 1=KT 2=LGU+
CODEF_AUTH_TELECOM=


# ───────────────────────────────────────────────────────────────────
#  10. 데모 옵션
# ───────────────────────────────────────────────────────────────────

# [선택] 작업자 생체 GET 응답의 민감 PII(보호자 이름·전화, 위·경도) 노출 여부
# 미설정/false: 기본 비노출(공개 터널 fail-safe). SOS 모달 보호자 연락·지도 링크 비활성.
# true: 신뢰된 로컬 데모에서만 명시 opt-in.
MOCK_VITAL_EXPOSE_PII=


# ═══════════════════════════════════════════════════════════════════
#  11. 개발 스크립트 전용 — 앱 런타임이 읽지 않는다
#      .env.local 에 넣을 필요가 없고, 스크립트 실행 시 인라인으로 주면 된다.
#      예: LAW_OC=rlaxorhs77 node scripts/law-snapshot-sync.mjs
# ═══════════════════════════════════════════════════════════════════

# scripts/law-snapshot-sync.mjs — 법제처 OC. MOLEG_OC 와 같은 값을 쓰면 된다.
LAW_OC=

# scripts/injection-test.mjs — 주입 테스트 대상 서버 주소와 작업자 ID
BASE_URL=
WORKER_ID=

# scripts/guard-anchor-audit.mjs — 가드 앵커 감사 옵션
GUARD_FILE=
LIST_ONLY=
BLANK_ONLY=

# scripts/guard-trace.mjs, guard-trace-fs.mjs — 추적 결과 출력 경로
GUARD_TRACE_OUT=

# scripts/mock-publish.mjs — 목업 수신기 주소
MOCK_RECEIVER_URL=
